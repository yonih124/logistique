# Développement local (hors Docker). En production, docker-compose.yml fournit ces valeurs.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/optistock
PORT=3000
JWT_SECRET=remplacez-par-un-secret-long
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=le-meme-secret-que-dans-ai-service
# Optionnel : nombre de reverse proxys devant l'API, sécurité du cookie de session.
# TRUST_PROXY=0
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
