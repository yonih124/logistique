# ===========================================================
#  OptiStock — configuration de production (docker compose)
#  Copier vers .env puis remplacer TOUTES les valeurs « changez-moi ».
#  Générer un secret :  openssl rand -hex 32
#  (utilisez des secrets hexadécimaux : ils vont dans des URL PostgreSQL)
# ===========================================================

# --- Adresse publique ---------------------------------------
# Avec un nom de domaine (HTTPS automatique Let's Encrypt) :
#   SITE_ADDRESS=optistock.mondomaine.mg
#   PUBLIC_URL=https://optistock.mondomaine.mg
#   COOKIE_SECURE=true
# Sans domaine, par l'adresse IP du serveur (HTTP uniquement) :
#   SITE_ADDRESS=:80
#   PUBLIC_URL=http://IP_DU_SERVEUR
#   COOKIE_SECURE=false
# Accès réservé au VPN WireGuard (voir DEPLOIEMENT.md) :
#   BIND_IP=ADRESSE_WIREGUARD_DU_SERVEUR
#   SITE_ADDRESS=:80
#   PUBLIC_URL=http://ADRESSE_WIREGUARD_DU_SERVEUR
#   COOKIE_SECURE=false
BIND_IP=0.0.0.0
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
COOKIE_SECURE=false
ACME_EMAIL=admin@example.com

# --- Base de données ----------------------------------------
POSTGRES_DB=optistock
POSTGRES_USER=optistock
POSTGRES_PASSWORD=changez-moi
# Compte lecture seule pour le service IA
AI_DB_USER=optistock_ai
AI_DB_PASSWORD=changez-moi

# --- Sécurité -----------------------------------------------
JWT_SECRET=changez-moi
JWT_EXPIRES_IN=8h
# Secret partagé entre l'API Node et le service IA
AI_SERVICE_TOKEN=changez-moi
AI_RETRAIN_DAYS=7
